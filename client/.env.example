# Скопируйте в client/.env. Значения VITE_* видны всем посетителям сайта, секретов здесь быть не должно.
# Номер WhatsApp цифрами с кодом страны, без плюса и пробелов (пример для +7 700 123 45 67: 77001234567)
VITE_WHATSAPP_PHONE=
# Почта для связи, показывается в подвале сайта (можно оставить пустой)
VITE_CONTACT_EMAIL=1231@gmail.com
