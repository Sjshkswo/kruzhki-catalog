# Скопируйте этот файл в .env и заполните. НИКОГДА не записывайте настоящие значения сюда:
# .env.example попадает в репозиторий, а .env нет.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ_POSTGRES@localhost:5432/kruzhki
# Любая длинная случайная строка (для подписи токенов входа):
JWT_SECRET=

# --- Почта (необязательно). Если не заполнено, письма не отправляются, сайт работает ---
# Аккаунт Gmail-отправителя и его ПАРОЛЬ ПРИЛОЖЕНИЯ (не обычный пароль):
MAIL_USER=
MAIL_PASS=
# Запасной адрес для организаторов с демо-почтой (.local):
NOTIFY_EMAIL=
# Адрес сайта для ссылок в письмах:
CLIENT_URL=http://localhost:5173
# Режим проверки без отправки (письма печатаются в терминале): раскомментируйте
# MAIL_MODE=console
